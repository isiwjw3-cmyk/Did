local flying = false
local flySpeed = 50
local upPressed, downPressed = false, false

UpBtn.MouseButton1Down:Connect(function() upPressed = true end)
UpBtn.MouseButton1Up:Connect(function() upPressed = false end)
DownBtn.MouseButton1Down:Connect(function() downPressed = true end)
DownBtn.MouseButton1Up:Connect(function() downPressed = false end)

local function enableFly(status, customSpeed)
    flying = status
    FlyControls.Visible = status
    if customSpeed then flySpeed = customSpeed end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if flying then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "IU_FlyVelocity"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = hrp

        task.spawn(function()
            while flying do
                RunService.RenderStepped:Wait()
                local moveDir = char.Humanoid.MoveDirection
                local yVel = 0
                if upPressed then yVel = flySpeed end
                if downPressed then yVel = -flySpeed end
                bv.Velocity = (moveDir * flySpeed) + Vector3.new(0, yVel, 0)
            end
            bv:Destroy()
        end)
    end
end

