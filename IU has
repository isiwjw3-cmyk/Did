-- ตรวจจับบทบาท (ESP)
local espActive = false
local function applyESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local highlight = char:FindFirstChild("IU_ESP") or Instance.new("Highlight")
            highlight.Name = "IU_ESP"
            highlight.Parent = char
            highlight.Enabled = espActive

            -- ตรวจสอบไอเทมมีด/ปืน
            local isMurderer = char:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife")
            local isSheriff = char:FindFirstChild("Gun") or p.Backpack:FindFirstChild("Gun")

            if isMurderer then
                highlight.FillColor = Color3.fromRGB(255, 0, 0) -- แดง
            elseif isSheriff then
                highlight.FillColor = Color3.fromRGB(0, 0, 255) -- น้ำเงิน
            else
                highlight.FillColor = Color3.fromRGB(0, 255, 0) -- เขียว
            end
        end
    end
end

createToggle(MM2Frame, 10, "สำหรับ MM2: ตรวจจับบทบาท", function(val)
    espActive = val
    if val then
        task.spawn(function()
            while espActive do
                applyESP()
                task.wait(1)
            end
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("IU_ESP") then
                    p.Character.IU_ESP:Destroy()
                end
            end
        end)
    end
end)

